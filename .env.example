# ─── Aplicação ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=farmerrr

# Streamer live platforms (OAuth apps; keep secrets on the server)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ─── Supabase (Etapa 2) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Provider social (Etapa 5) ────────────────────────────────────────────────
# "mock" = dados falsos realistas, sem precisar da app TikTok aprovada
# "tiktok" = API oficial
SOCIAL_PROVIDER=mock

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# Chave AES-256 (32 bytes em base64) para cifrar tokens na base de dados
# Gerar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Segredo dos cookies de sessão do clipper
CLIPPER_SESSION_SECRET=

# ─── Cron (Etapa 6) ───────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Stripe (Etapa 8) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
